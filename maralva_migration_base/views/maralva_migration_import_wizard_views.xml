<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maralva_migration_import_wizard_form" model="ir.ui.view">
        <field name="name">maralva.migration.import.wizard.form</field>
        <field name="model">maralva.migration.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar">
                <div class="alert alert-warning" role="alert" invisible="not source_app_warning">
                    <field name="source_app_warning" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <field name="file_ids" widget="many2many_tags"/>
                    <field name="source_app" readonly="1"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="group_id"/>
                        <field name="selected"/>
                        <field name="related_line_ids" widget="many2many_tags"
                            domain="[('group_id', '=', group_id)]"/>
                    </list>
                </field>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_maralva_migration_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar</field>
        <field name="res_model">maralva.migration.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_maralva_migration_import_file"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
