<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maralva_migration_batch_list" model="ir.ui.view">
        <field name="name">maralva.migration.batch.list</field>
        <field name="model">maralva.migration.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source_app"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="date_start"/>
                <field name="mapping_count"/>
                <field name="log_count"/>
            </list>
        </field>
    </record>

    <record id="view_maralva_migration_batch_form" model="ir.ui.view">
        <field name="name">maralva.migration.batch.form</field>
        <field name="model">maralva.migration.batch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="source_app"/>
                            <field name="company_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notas..."/>
                    <notebook>
                        <page string="Mapeos de IDs">
                            <field name="mapping_ids">
                                <list>
                                    <field name="source_model"/>
                                    <field name="source_id"/>
                                    <field name="res_model"/>
                                    <field name="res_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Incidencias">
                            <field name="log_ids">
                                <list>
                                    <field name="create_date"/>
                                    <field name="level"/>
                                    <field name="res_model"/>
                                    <field name="source_id"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_maralva_migration_batch" model="ir.actions.act_window">
        <field name="name">Lotes de migración</field>
        <field name="res_model">maralva.migration.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_maralva_migration_root"
        name="Migraciones Maralva"
        parent="base.menu_custom"
        groups="base.group_system"
        sequence="120"/>

    <menuitem id="menu_maralva_migration_batch"
        name="Lotes de migración"
        parent="menu_maralva_migration_root"
        action="action_maralva_migration_batch"
        groups="base.group_system"
        sequence="10"/>

</odoo>
