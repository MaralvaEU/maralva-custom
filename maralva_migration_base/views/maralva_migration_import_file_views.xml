<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maralva_migration_import_file_list" model="ir.ui.view">
        <field name="name">maralva.migration.import.file.list</field>
        <field name="model">maralva.migration.import.file</field>
        <field name="arch" type="xml">
            <list>
                <field name="filename"/>
                <field name="description"/>
                <field name="file_type"/>
                <field name="source_app"/>
                <field name="check_state"/>
                <field name="company_mode"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_maralva_migration_import_file_form" model="ir.ui.view">
        <field name="name">maralva.migration.import.file.form</field>
        <field name="model">maralva.migration.import.file</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="filename" readonly="1"/>
                            <field name="file" filename="filename"/>
                            <field name="file_type" readonly="1"/>
                            <field name="source_app"/>
                            <field name="company_mode"/>
                            <field name="company_id" invisible="company_mode != 'single'"
                                required="company_mode == 'single'"/>
                        </group>
                        <group>
                            <field name="check_state"/>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Relación de compañías" invisible="company_mode != 'multi'">
                            <field name="company_line_ids">
                                <list editable="bottom">
                                    <field name="source_company_code"/>
                                    <field name="company_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tablas destino">
                            <field name="target_line_ids">
                                <list editable="bottom">
                                    <field name="res_model"/>
                                    <field name="name"/>
                                    <field name="import_state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_maralva_migration_import_file" model="ir.actions.act_window">
        <field name="name">Ficheros subidos</field>
        <field name="res_model">maralva.migration.import.file</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_maralva_migration_import_file"
        name="Ficheros subidos"
        parent="menu_maralva_migration_root"
        action="action_maralva_migration_import_file"
        groups="base.group_system"
        sequence="5"/>

</odoo>
