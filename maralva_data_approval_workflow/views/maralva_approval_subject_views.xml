<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maralva_approval_subject_list" model="ir.ui.view">
        <field name="name">maralva.approval.subject.list</field>
        <field name="model">maralva.approval.subject</field>
        <field name="arch" type="xml">
            <list string="Materias de aprobación">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="responsible_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_maralva_approval_subject_form" model="ir.ui.view">
        <field name="name">maralva.approval.subject.form</field>
        <field name="model">maralva.approval.subject</field>
        <field name="arch" type="xml">
            <form string="Materia de aprobación">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej. Ventas, Compras, Administración..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="responsible_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Campos vigilados">
                            <field name="field_ids">
                                <list editable="bottom">
                                    <field name="model_id"/>
                                    <field name="model_name" column_invisible="1"/>
                                    <field name="field_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Técnico" groups="base.group_no_one">
                        <field name="automation_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_maralva_approval_subject" model="ir.actions.act_window">
        <field name="name">Materias de aprobación</field>
        <field name="res_model">maralva.approval.subject</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_maralva_approval_workflow_root"
              name="Flujo de aprobación de datos"
              parent="maralva_default_values.menu_maralva_root"
              sequence="30"/>
    <menuitem id="menu_maralva_approval_subject"
              name="Materias de aprobación"
              parent="menu_maralva_approval_workflow_root"
              action="action_maralva_approval_subject"
              sequence="10"/>
</odoo>
