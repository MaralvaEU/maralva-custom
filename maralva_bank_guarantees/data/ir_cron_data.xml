<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_maralva_bank_guarantee_notify_expiring" model="ir.cron">
        <field name="name">Maralva: avisar avales a 30 días de vencer</field>
        <field name="model_id" ref="model_maralva_bank_guarantee"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_expiring_guarantees()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_maralva_bank_guarantee_extend_forecasts" model="ir.cron">
        <field name="name">Maralva: extender horizonte de previsión de liquidaciones (avales indefinidos)</field>
        <field name="model_id" ref="model_maralva_bank_guarantee"/>
        <field name="state">code</field>
        <field name="code">model._cron_extend_indefinite_settlement_forecasts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_maralva_bank_guarantee_post_settlements" model="ir.cron">
        <field name="name">Maralva: contabilizar liquidaciones automáticas de avales</field>
        <field name="model_id" ref="model_maralva_bank_guarantee"/>
        <field name="state">code</field>
        <field name="code">model._cron_post_pending_settlements()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
